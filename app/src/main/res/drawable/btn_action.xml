<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2A2D35" android:endColor="#454955" />
            <stroke android:width="1dp" android:color="#1B1D22" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#5A5F6D" android:endColor="#3A3E49" />
            <stroke android:width="1dp" android:color="#6E7482" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
